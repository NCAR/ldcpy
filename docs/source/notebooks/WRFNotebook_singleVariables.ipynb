   "source": [
    "#### WRF Example Notebook - Single Variables\n",
    "\n",
    "Demonstrates using ldcpy on wrf CONUS 404 data - single variables. \n",
    "\n",
    "On NCAR's Jupyterhub, environment NPL 2024b is a good option (Note: it contains an old version of ldcpy that does not support WRF data.  So make sure you have a recent version from https://github.com/NCAR/ldcpy.)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "b8580f58-ca1f-41b4-b2ff-151796db257c",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import sys\n",
    "\n",
    "import cf_xarray as cf\n",
    "import numpy as np\n",
    "import xarray as xr\n",
    "import xwrf\n",
    "\n",
    "%load_ext autoreload\n",
    "%autoreload 2\n",
    "%matplotlib inline\n",
    "\n",
    "# loading our own ldcpy repo\n",
    "sys.path.insert(0, '/glade/u/home/abaker/repos/my_ldcpy')\n",
    "# suppress all of the divide by zero warnings\n",
    "import warnings\n",
    "\n",
    "# sys.path.insert(0, '/../../../')\n",
    "import ldcpy\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9d690619-053a-4ebc-bfd0-d4c42dfb526f",
   "metadata": {},
   "source": [
    "To look at SPERR-compressed data, you need the HDF5 plugin installed and the path specified in HDF5_PLUGIN_PATH. So let's verify that. (Note, I have all my plugins in the same zfp directory)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "589bdaea-e4a6-4a22-8be3-f4a9a30e0c63",
   "metadata": {},
   "outputs": [],
   "source": [
    "os.environ[\"HDF5_PLUGIN_PATH\"] = '/glade/work/abaker/compress-libs/casper_plugins'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "d29b0397-50c8-4ae7-ab13-79bed9a5f7b0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Variables = \n",
      "['RAINNCV', 'T2', 'LWUPT', 'V10', 'QVAPOR', 'U10', 'V', 'Q2', 'U', 'ACECAN', 'SNLIQ', 'TK']\n",
      "Compression options = \n",
      "['sperr_psnr100', 'sperr_pwe1e-1', 'sperr_psnr150', 'zfp_p20', 'gbr_5', 'gbr_3', 'sperr_psnr50', 'sperr_pwe1e-3', 'gbr_1', 'sperr_pwe1e-5', 'sperr_psnr175', 'zfp_p12', 'sperr_psnr200', 'zfp_p16', 'sperr_psnr125', 'gbr_4', 'sperr_pwe1e-2', 'gbr_2', 'lossless', 'zfp_p22', 'sperr_pwe1e-4', 'sperr_psnr75', 'zfp_p8', 'sperr_psnr225', 'zfp_p10', 'orig', 'zfp_p14', 'zfp_p18']\n"
     ]
    }
   ],
   "source": [
    "# Some CONUS 404 wrf data to look at (24 hourly sliced put into a single file for a single variable)\n",
    "# (wrf2d_d01_2020-07-01_00:00:00 => wrf2d_d01_2020-07-01_23:00:00 , and then for 3d also)\n",
    "\n",
    "# this contains lat/lon info\n",
    "fileconsts = \"/glade/campaign/cisl/asap/abaker/wrf/wrfconstants_usgs404.nc\"\n",
    "\n",
    "# get the file names\n",
    "base_dir = \"/glade/campaign/cisl/asap/abaker/wrf/single_vars_wrf_24hr/\"\n",
    "\n",
    "# which variables do we have in this directory\n",
    "varnames = os.listdir(base_dir)\n",
    "print(\"Variables = \")\n",
    "print(varnames)\n",
    "\n",
    "# which compressor options\n",
    "comp_opts = os.listdir(base_dir + varnames[0])\n",
    "print(\"Compression options = \")\n",
    "print(comp_opts)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "7e9a8172-f56a-4cac-acd3-1a507936a44f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "dataset size in GB 3.74\n",
      "\n"
     ]
    }
   ],
   "source": [
    "# let's look at T2 data\n",
    "varname = 'T2'\n",
    "filename = 'wrf2d_combined_T2.nc'\n",
    "ds_all = []\n",
    "ds_label = []\n",
    "ds_size = []\n",
    "# wrf files have to be open and post-processsed\n",
    "for i in comp_opts:\n",
    "    full_filename = base_dir + varname + \"/\" + i + \"/\" + filename\n",
    "    # print(full_filename)\n",
    "    ds_label.append(i)\n",
    "    ds_all.append(xr.open_dataset(full_filename, engine=\"netcdf4\").xwrf.postprocess())\n",
    "    ds_size.append(os.path.getsize(full_filename))\n",
    "t2_ds_dict = dict(zip(ds_label, ds_all))\n",
    "t2_size_dict = dict(zip(ds_label, ds_size))\n",
    "\n",
    "# sorted(t2_size_dict)\n",
    "indx = np.argsort(ds_size)[::-1]\n",
    "sorted_ds_size = [ds_size[i] for i in indx]\n",
    "sorted_ds_label = [ds_label[i] for i in indx]\n",
    "sorted_t2_size_dict = dict(zip(sorted_ds_label, sorted_ds_size))\n",
    "\n",
    "# wrf coordinates file\n",
    "ds_const = xr.open_dataset(fileconsts, engine=\"netcdf4\").xwrf.postprocess()\n",
    "\n",
    "# make an ldcpy collection of all of this T2 data\n",
    "T2_col = ldcpy.collect_datasets(\n",
    "    \"wrf\",\n",
    "    [\"T2\"],\n",
    "    ds_all,\n",
    "    ds_label,\n",
    "    coords_ds=ds_const,\n",
    "    file_sizes=ds_size,\n",
    ")"
   ]
  },
